# MongoDB
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_DB=emoji-platform

# Redis / Upstash
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-token>

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-<your-key>

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Emoji Meaning

# Google Gemini AI
GEMINI_API_KEY=<your-gemini-api-key>

# WordPress Blog (headless CMS)
WORDPRESS_API_URL=https://your-wp-site.com/wp-json/wp/v2

# --- AI abuse hardening / rate limits (all optional; defaults shown) ---
# Per-IP sliding-window limits for the text tools (smart-search, vibe-search,
# text-to-emoji, caption).
# RL_TEXT_PER_MIN=15
# RL_TEXT_PER_DAY=150
# Per-IP limits for the expensive image tool (emoji-maker).
# RL_IMAGE_PER_MIN=4
# RL_IMAGE_PER_DAY=20
# Per-IP limit for the public search-index endpoints (fails open).
# RL_PUBLIC_PER_MIN=30
# Global daily HARD ceilings across ALL clients — the real bill cap. Only real
# (cache-miss) Gemini calls count. Tune IMAGE against your budget: image gen is
# ~$0.039/image and emoji-maker requests 4/call, so 45/day ≈ ~$7/day worst case.
# RL_IMAGE_GLOBAL_DAILY=45
# RL_TEXT_GLOBAL_DAILY=10000
# Extra allowed origins for the AI POST routes (comma-separated). Same-origin and
# localhost are always allowed; set this only for additional trusted hosts.
# RL_ALLOWED_ORIGINS=https://emojimeaning.com
